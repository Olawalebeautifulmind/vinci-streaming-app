# Copy to .env for local development. Never commit .env.
# Only VITE_ variables reach the browser, so they must be public values.

# Public (browser) settings from your Supabase project: Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-only settings. In production set these as Worker secrets, not in this file.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Stream (live video). Token needs the "Stream: Edit" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Tests only: point at tests/mock-cloudflare.mjs
# CLOUDFLARE_API_BASE=http://127.0.0.1:8788/client/v4
